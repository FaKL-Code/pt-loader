{
  "name": "@fakl-code/pt-loader",
  "version": "0.1.2",
  "description": "Loader for Priston Tale 3D assets (SMD / SMB / INX / encrypted BMP & TGA) targeting three.js.",
  "type": "module",
  "license": "MIT",
  "author": "Julio Facal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaKL-Code/pt-loader.git"
  },
  "homepage": "https://github.com/FaKL-Code/pt-loader#readme",
  "bugs": {
    "url": "https://github.com/FaKL-Code/pt-loader/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./viewer": {
      "types": "./types/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "pt-assets": "dist/cli.js"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "three": ">=0.152.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": false
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test test/build.test.js test/cli.test.js test/core.test.js test/integration.test.js test/package.test.js test/picking.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm pack --dry-run",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run format:check && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "three": "^0.186.0"
  },
  "keywords": [
    "priston-tale",
    "three",
    "threejs",
    "smd",
    "loader",
    "game-assets",
    "webgl"
  ]
}
